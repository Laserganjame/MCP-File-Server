# Use a long, random value. Set the real value in the shell, PM2 environment,
# or deployment secret store. This project does not load .env files automatically.
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Optional: comma-separated browser origins for a specific HTTPS tunnel or web client.
# Leave unset for the default local-only Origin allowlist.
# MCP_ALLOWED_ORIGINS=https://your-tunnel.example
